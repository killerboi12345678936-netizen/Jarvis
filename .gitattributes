# Normalize line endings: text files are stored with LF in the
# repository and converted to the platform default on checkout.
* text=auto

# Windows scripts need CRLF in the working tree.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets - never normalize.
*.onnx binary
*.wav binary
*.webm binary
*.png binary
*.ico binary
*.db binary
