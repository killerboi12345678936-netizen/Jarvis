DEFAULT_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434

# Choose one local model at a time; switch with /model while Jarvis runs.
OLLAMA_MODEL=qwen2.5:3b
DOLPHIN_MODEL=dolphin3:8b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=openai/gpt-oss-20b

HISTORY_LIMIT=20
# Voice configuration
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

PIPER_EXECUTABLE=piper
PIPER_MODEL=data/voice/en_US-lessac-medium.onnx

# Voice streaming
VOICE_SAMPLE_RATE=16000
VAD_SPEECH_THRESHOLD=0.015
VAD_SILENCE_MS=900
VAD_MIN_SPEECH_MS=300
VAD_BARGE_IN_THRESHOLD=0.035
WHISPER_PRELOAD=0

# Tools
TOOLS_ENABLED=1
TOOL_MAX_ROUNDS=2
DESKTOP_ALLOWED_APPS=notepad=notepad,calculator=calc,paint=mspaint

# Telegram (READ-ONLY study groups; Jarvis never sends messages)
# 1. Create an app at https://my.telegram.org for api_id/api_hash.
# 2. Run: python scripts/telegram_login.py  -> paste session string here.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
TELEGRAM_GROUP_MATH=
TELEGRAM_GROUP_PHYSICS=
TELEGRAM_GROUP_CHEMISTRY=

# Calendar
# Point CALENDAR_ICS_URL at your calendar's private ICS address, or
# CALENDAR_ICS_FILE at a local .ics export file.
CALENDAR_ICS_URL=
CALENDAR_ICS_FILE=

# Memory
MEMORY_CONTEXT_LIMIT=6