# ---- Secrets and environment ----
.env
.env.*
!.env.example

# ---- Python ----
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# ---- Databases (private user data: memories, sessions, actions) ----
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ---- Device pairing token (per-installation secret) ----
data/device_token.txt

# ---- TLS dev certificates (private key) ----
data/certs/

# ---- Telegram session files (never commit a session) ----
*.session
*.session-journal

# ---- Logs (may contain personal messages) ----
*.log
logs/

# ---- Personal voice recordings (microphone audio) ----
data/voice/*.wav
data/voice/*.webm

# ---- Voice models (download separately; too large to track) ----
data/voice/*.onnx
data/voice/*.onnx.json

# ---- Personal workspace notes created at runtime ----
data/workspace/*.txt

# ---- Frontend dependencies and build output ----
node_modules/
dist/
build/
.vite/
coverage/
*.tsbuildinfo

# ---- IDE and OS ----
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini
